OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CONSENSUS_API_KEY=
# API spending is opt-in, even when a key exists.
ENABLE_PAID_API=false
MAX_INGEST_DOCUMENTS=50
MAX_FILE_MB=40
MAX_INGEST_TOKENS=500000
EMBEDDING_USD_PER_MILLION=0.02
INPUT_USD_PER_MILLION=2.50
OUTPUT_USD_PER_MILLION=10.00
# Local API only. Set a token for all /api routes if using a shared machine.
FLAME_API_TOKEN=
